# Safe defaults. Never put a seed phrase, private key or wallet secret here.
# Variables must be exported or placed in a local .env (never committed); real env wins over .env.
AUTOTRADE_MODE=paper
AUTOTRADE_LIVE_ENABLED=false
AUTOTRADE_INITIAL_EQUITY_IDR=1000000
AUTOTRADE_DB_PATH=data/autotrade.sqlite3
AUTOTRADE_LOG_LEVEL=INFO
# true = never touch the network (ingest/provider probes are skipped, exit code 3)
AUTOTRADE_OFFLINE=false

# --- Solana RPC (public endpoint by default; rate-limited, no SLA) ---
# Optional override. If your RPC provider embeds a key in the URL, keep it ONLY in your local env.
SOLANA_RPC_URL=
# Optional comma-separated fallbacks, tried only after the primary fails transiently
SOLANA_RPC_FALLBACK_URLS=
SOLANA_RPC_COMMITMENT=confirmed

# --- DEX data sources (public; no key required) ---
AUTOTRADE_ENABLE_DEXSCREENER=true
DEXSCREENER_BASE_URL=https://api.dexscreener.com
DEXSCREENER_RPS=4            # documented limit 300 req/min => max 5
AUTOTRADE_ENABLE_JUPITER=true
JUPITER_BASE_URL=https://lite-api.jup.ag
JUPITER_RPS=1
# Optional Jupiter key (sent as x-api-key); keep it only in your local env
JUPITER_API_KEY=
# Optional Birdeye OHLCV; without a key Birdeye is simply disabled
BIRDEYE_API_KEY=
AUTOTRADE_OHLCV_INTERVAL=15m
AUTOTRADE_OHLCV_CANDLES=16
# Max relative USD-price deviation between DEX Screener and Jupiter before flagging
AUTOTRADE_PRICE_TOLERANCE_FRACTION=0.05

# --- M2 discovery + safety screening (strict defaults) ---
AUTOTRADE_DISCOVERY_ENABLED=false
AUTOTRADE_MAX_CANDIDATES_PER_CYCLE=20
AUTOTRADE_CANDIDATE_MAX_AGE_HOURS=24
AUTOTRADE_SAFETY_MIN_LIQUIDITY_USD=10000
AUTOTRADE_SAFETY_MIN_POOL_AGE_MINUTES=30
AUTOTRADE_SAFETY_MAX_TOP_HOLDERS_PCT=40
AUTOTRADE_SAFETY_MIN_SELLS_24H=20
AUTOTRADE_SAFETY_MIN_SELLS_1H=1
AUTOTRADE_SAFETY_MIN_SELL_BUY_RATIO=0.10
AUTOTRADE_SAFETY_ALLOW_TOKEN_2022=false

# --- M3 features / signals (research only; untuned defaults) ---
AUTOTRADE_MAX_TX_PARSE_PER_CYCLE=10
AUTOTRADE_SIGNAL_TTL_SECONDS=300
AUTOTRADE_SIGNAL_MAX_SAFETY_AGE_SECONDS=300
AUTOTRADE_SIGNAL_MIN_RET_15M=0.02
AUTOTRADE_SIGNAL_MIN_IMBALANCE_5M=0.05
AUTOTRADE_SIGNAL_MIN_TXN_ACCEL=1.0
AUTOTRADE_SIGNAL_MAX_LIQ_DRAWDOWN_1H=0.10
AUTOTRADE_SIGNAL_INVALIDATION_PRICE_DROP=0.10
AUTOTRADE_SIGNAL_INVALIDATION_LIQ_DROP=0.20

# --- M4 risk gate (paper intents only) ---
# REQUIRED for any intent: no default is ever assumed (unset => every intent rejected)
AUTOTRADE_USD_IDR_RATE=
# Your explicit hypothesis of net edge per trade (fraction); unset => rejected until validated
AUTOTRADE_RISK_ASSUMED_EDGE_FRACTION=
AUTOTRADE_RISK_DEX_FEE_FRACTION=0.0030
AUTOTRADE_RISK_NETWORK_FEE_USD=0.02
AUTOTRADE_RISK_EDGE_MARGIN_FRACTION=0.01
AUTOTRADE_RISK_MIN_ORDER_USD=1
AUTOTRADE_RISK_MAX_FIXED_COST_FRACTION=0.04
AUTOTRADE_RISK_MAX_PRICE_IMPACT=0.01
AUTOTRADE_RISK_MAX_SLIPPAGE=0.01
AUTOTRADE_RISK_MAX_QUOTE_AGE_SECONDS=5
AUTOTRADE_RISK_PROVIDER_MAX_AGE_SECONDS=120
AUTOTRADE_RISK_COOLDOWN_SECONDS=3600

# --- M6 paper broker (simulated execution; nothing is sent) ---
AUTOTRADE_PAPER_LATENCY_SECONDS=15
AUTOTRADE_PAPER_MAX_PENDING_SECONDS=300
AUTOTRADE_PAPER_MAX_HOLD_SECONDS=3600
AUTOTRADE_PAPER_SLIPPAGE_BUFFER=0.005
AUTOTRADE_PAPER_FAILED_TX_RATE=0.05
AUTOTRADE_PAPER_DEAD_AFTER_SECONDS=3600
AUTOTRADE_PAPER_DEAD_HAIRCUT=1.0
AUTOTRADE_PAPER_DRAW_LABEL=paper

# --- Resilience (defaults shown) ---
AUTOTRADE_HTTP_TIMEOUT_SECONDS=10
AUTOTRADE_MAX_ATTEMPTS=3
AUTOTRADE_BACKOFF_BASE_SECONDS=0.5
AUTOTRADE_BACKOFF_MAX_SECONDS=8
AUTOTRADE_MAX_REQUESTS_PER_SECOND=4

# --- Ingestion ---
AUTOTRADE_MAX_CONCURRENCY=4
AUTOTRADE_POLL_INTERVAL_SECONDS=60
AUTOTRADE_MAX_SNAPSHOT_AGE_SECONDS=30
AUTOTRADE_WALLET_ACTIVITY_LIMIT=50
# Comma-separated base58 addresses to ingest
AUTOTRADE_WATCH_MINTS=
AUTOTRADE_WATCH_WALLETS=
