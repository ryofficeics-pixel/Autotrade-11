# Safe defaults. Never put a seed phrase, private key or wallet secret here.
# Variables must be exported or placed in a local .env (never committed); real env wins over .env.
AUTOTRADE_MODE=paper
AUTOTRADE_LIVE_ENABLED=false
AUTOTRADE_INITIAL_EQUITY_IDR=1000000
AUTOTRADE_DB_PATH=data/autotrade.sqlite3
AUTOTRADE_LOG_LEVEL=INFO
# true = never touch the network (ingest/provider probes are skipped, exit code 3)
AUTOTRADE_OFFLINE=false

# --- Solana RPC (public endpoint by default; rate-limited, no SLA) ---
# Optional override. If your RPC provider embeds a key in the URL, keep it ONLY in your local env.
SOLANA_RPC_URL=
# Optional comma-separated fallbacks, tried only after the primary fails transiently
SOLANA_RPC_FALLBACK_URLS=
SOLANA_RPC_COMMITMENT=confirmed

# --- Resilience (defaults shown) ---
AUTOTRADE_HTTP_TIMEOUT_SECONDS=10
AUTOTRADE_MAX_ATTEMPTS=3
AUTOTRADE_BACKOFF_BASE_SECONDS=0.5
AUTOTRADE_BACKOFF_MAX_SECONDS=8
AUTOTRADE_MAX_REQUESTS_PER_SECOND=4

# --- Ingestion ---
AUTOTRADE_MAX_CONCURRENCY=4
AUTOTRADE_POLL_INTERVAL_SECONDS=60
AUTOTRADE_MAX_SNAPSHOT_AGE_SECONDS=30
AUTOTRADE_WALLET_ACTIVITY_LIMIT=50
# Comma-separated base58 addresses to ingest
AUTOTRADE_WATCH_MINTS=
AUTOTRADE_WATCH_WALLETS=
